{
    "mcp.servers": {
        "blender": {
            "command": "uvx",
            "args": ["blender-mcp"],
            "env": {
                "BLENDER_HOST": "localhost",
                "BLENDER_PORT": "9876"
            }
        }
    },
    "github.copilot.advanced": {
        "debug.overrideEngine": "copilot-gpt-4o"
    },
    "github.copilot.enable": {
        "*": true,
        "yaml": false,
        "plaintext": false,
        "markdown": false
    }
}